#!/bin/sh
#
# nest-surface: the Q-SYS control surface on the thermostat's screen
# (crates/surface), run by its launcher and kept running by monit.

LAUNCHER=/media/data/nest-surface/nest-surface.sh
PIDFILE=/var/run/nest-surface.pid

case "${1}" in
start)
    start-stop-daemon -S -q -b -m -p ${PIDFILE} -x /bin/sh -- ${LAUNCHER}
    ;;
stop)
    start-stop-daemon -K -q -s TERM -p ${PIDFILE}
    rm -f ${PIDFILE}
    ;;
restart)
    ${0} stop
    sleep 2
    ${0} start
    ;;
*)
    echo "Usage: ${0} {start|stop|restart}"
    exit 1
    ;;
esac
